# ===================================================================
# ComicCraft Environment Configuration Template
# Duplicate this file as .env and fill in your private API keys.
# ===================================================================

# -------------------------------------------------------------------
# 1. Google Gemini API Key
# -------------------------------------------------------------------
# Used for:
#   - Gemini 1.5 Flash: Structured 5-panel comic narrative outlining
#   - Gemini 1.5 Pro: High-fidelity comic dialogue & narration scriptwriting
# Where to obtain:
#   https://aistudio.google.com/
#   Click 'Get API Key' -> 'Create API Key in New Project'
GEMINI_API_KEY=your_gemini_api_key

# -------------------------------------------------------------------
# 2. Hugging Face API Key / User Access Token
# -------------------------------------------------------------------
# Used for:
#   - Stable Diffusion v1.5 / SDXL comic panel illustration synthesis
# Where to obtain:
#   https://huggingface.co/settings/tokens
#   Click 'Create new token' -> Select Role: 'Read' -> Copy Token
HF_API_KEY=your_huggingface_api_key

# -------------------------------------------------------------------
# Model Configurations (Optional Customizations)
# -------------------------------------------------------------------
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
HF_MODEL_ID=runwayml/stable-diffusion-v1-5

