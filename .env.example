# ===================================================================
# ComicCraft Environment Configuration Template
# Duplicate this file as .env and fill in your private API keys.
# ===================================================================

# -------------------------------------------------------------------
# 1. Google Gemini API Key (Required for AI generation)
# -------------------------------------------------------------------
# Used for:
#   - Story outlining & 5-panel beat structuring
#   - High-fidelity dialogue & narration scriptwriting
# Where to obtain:
#   https://aistudio.google.com/
#   Click 'Get API Key' -> 'Create API Key in New Project'
GEMINI_API_KEY=your_gemini_api_key

# -------------------------------------------------------------------
# 2. Hugging Face API Key (Optional)
# -------------------------------------------------------------------
# Where to obtain:
#   https://huggingface.co/settings/tokens
#   Role: 'Read'
HF_API_KEY=your_huggingface_api_key

# -------------------------------------------------------------------
# 3. Model Configurations
# -------------------------------------------------------------------
GEMINI_FLASH_MODEL=gemini-flash-lite-latest
GEMINI_PRO_MODEL=gemini-flash-lite-latest
HF_MODEL_ID=runwayml/stable-diffusion-v1-5
